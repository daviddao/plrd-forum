# Copy to .env.local. Never commit the populated file.

# Required: generate with `openssl rand -hex 32`, then paste the value here.
# No default password is provided. Use a separate secret for each deployment.
SESSION_SECRET=

# Must match the browser's origin exactly for ATProto OAuth.
PUBLIC_URL=http://127.0.0.1:3457

# Passwordless email sign-in provider. Handle login works without this setting.
EPDS_URL=https://certified.one

# Optional: index these public accounts when the database is empty.
# This reads published records; it never creates posts.
SEED_ACTORS=plrd.org

# Optional: defaults to ./forum.db. Use a persistent volume in production.
# Vercel demos need /tmp/forum.db and lose the index on cold starts.
# DATABASE_PATH=/tmp/forum.db

# Optional public presentation settings. NEXT_PUBLIC_* values reach browsers.
NEXT_PUBLIC_SITE_NAME=Open Lab
# NEXT_PUBLIC_SITE_URL=https://your-forum.example
# NEXT_PUBLIC_TYPEKIT_ID=

# Optional server settings. The built-in Jetstream endpoint is used if omitted.
# JETSTREAM_URL=wss://jetstream2.us-east.bsky.network/subscribe
# OAUTH_AUTHORIZE_REWRITES={}
