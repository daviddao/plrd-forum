  "webhooks": {},
  "components": {
    "securitySchemes": {
      "atprotoOAuth": {
        "type": "oauth2",
        "description": "ATProto OAuth (authorization code + PKCE) against the user's identity provider; no API keys are issued.",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://plrd-forum.vercel.app/oauth/login",
            "tokenUrl": "https://plrd-forum.vercel.app/oauth/callback",
            "scopes": {}
          }
        }
      }
    },
    "headers": {
      "RateLimitLimit": {
        "description": "Requests allowed per window.",
        "schema": {
          "type": "string",
          "example": "120"
        }
      },
      "RateLimitRemaining": {
        "description": "Requests remaining in the current window.",
        "schema": {
          "type": "string",
          "example": "117"
        }
      },
      "RateLimitReset": {
        "description": "Unix seconds when the window resets.",
        "schema": {
          "type": "string",
          "example": "1787361600"
        }
      },
      "RateLimitPolicy": {
        "description": "Policy string, e.g. 120;w=60.",
        "schema": {
          "type": "string",
          "example": "120;w=60"
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Malformed request",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "No valid ATProto OAuth session",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "RateLimited": {
        "description": "Too many requests — honor Retry-After",
        "headers": {
          "Retry-After": {
            "schema": {
              "type": "string",
              "example": "60"
            }
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "ServerError": {
        "description": "Unexpected server error",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      }
    },
    "schemas": {
      "Problem": {
        "type": "object",
        "description": "RFC 9457 problem details",
        "properties": {
          "type": {
            "type": "string",
            "format": "uri-reference"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "description": "Machine-readable error code, e.g. api_route_not_found"
          },
          "resolution": {
            "type": "string",
            "description": "Concrete hint for fixing the request"
          },
          "instance": {
            "type": "string",
            "format": "uri-reference"
          }
        },
        "required": [
          "title",
          "status"
        ]
      },
      "PostSummary": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "description": "Site-relative post URL, /posts/<did>/<rkey>"
          },
          "author": {
            "type": "string",
            "description": "Author handle or DID"
          },
          "karma": {
            "type": "integer",
            "minimum": 0
          },
          "commentCount": {
            "type": "integer",
            "minimum": 0
          },
          "publishedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "excerpt": {
            "type": "string"
          }
        },
        "required": [
          "title",
          "url",
          "karma",
          "commentCount"
        ]
      },
      "PostList": {
        "type": "object",
        "properties": {
          "posts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PostSummary"
            }
          }
        },
        "required": [
          "posts"
        ]
      },
      "BackfillRequest": {
        "type": "object",
        "required": [
          "actor"
        ],
        "properties": {
          "actor": {
            "type": "string",
            "description": "Handle or DID, e.g. awarm.space",
            "examples": [
              "awarm.space"
            ]
          }
        }
      },
      "BackfillResult": {
        "type": "object",
        "properties": {
          "indexed": {
            "type": "integer",
            "description": "Number of records indexed from the actor's repo."
          }
        }
      },
      "CreateResult": {
        "type": "object",
        "properties": {
          "uri": {
            "type": "string",
            "description": "AT-URI of the created record",
            "examples": [
              "at://did:plc:…/site.standard.document/3abc…"
            ]
          }
        }
      },
      "JsonRpcResponse": {
        "type": "object",
        "description": "JSON-RPC 2.0 response object (result or error)",
        "properties": {
          "jsonrpc": {
            "type": "string",
            "const": "2.0"
          },
          "id": {},
          "result": {
            "type": "object"
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "integer"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "CreatePostRequest": {
        "type": "object",
        "required": [
          "title",
          "blocks"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "blocks": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "Leaflet linear-document blocks (pub.leaflet.blocks.* types)."
          }
        }
      },
      "CreateCommentRequest": {
        "type": "object",
        "required": [
          "subject"
        ],
        "properties": {
          "subject": {
            "type": "string",
            "description": "AT-URI of the post being commented on."
          },
          "plaintext": {
            "type": "string",
            "description": "Markdown richtext body; a bare reaction label (e.g. Agreed) creates a named reaction."
          },
          "parent": {
            "type": "object",
            "description": "Optional parent comment reference for threading."
          }
        }
      },
      "VoteRequest": {
        "type": "object",
        "required": [
          "subject"
        ],
        "properties": {
          "subject": {
            "type": "string",
            "description": "AT-URI of the post to recommend."
          }
        }
      },
      "SubscribeRequest": {
        "type": "object",
        "required": [
          "publication"
        ],
        "properties": {
          "publication": {
            "type": "string",
            "description": "AT-URI of the publication to follow."
          }
        }
      }
    }
  }
}